{
  "name": "miss-ann-science",
  "version": "1.0.0",
  "private": true,
  "description": "منصة مس آن بهاء لتعليم العلوم - المرحلة الابتدائية",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --parallel -r --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "argon2",
      "sharp",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
