# ═══ إعدادات الإنتاج — انسخ هذا الملف إلى deploy/.env على السيرفر واملأ القيم ═══
# deploy/.env سرّي: لا يُرفع على GitHub (مستثنى في .gitignore) ولا يُرسل في شات.
# توليد قيمة عشوائية قوية:  openssl rand -hex 32

# ── الدومين و HTTPS ──
# بدون https:// — سجل A يشير لعنوان السيرفر
DOMAIN=missann.example.com
# بريد لتنبيهات شهادة HTTPS (Let's Encrypt)
ACME_EMAIL=owner@example.com

# ── قاعدة البيانات (داخل الشبكة الخاصة فقط) ──
POSTGRES_USER=missann
# إلزامي: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=missann

# ── الجلسات (إلزامي؛ 32 حرفاً على الأقل ومختلفان — الخادم يرفض الإقلاع بغير ذلك) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# ── أول أدمن (يُستخدم مرة واحدة مع أمر الـ seed في RUNBOOK) ──
SEED_ADMIN_PHONE=01000000000
# 10 أحرف على الأقل؛ غيّرها من الملف الشخصي بعد أول دخول
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
# لإضافة كورسات وطالب وأكواد تجريبية (للتجربة فقط)
# SEED_DEMO=true

# ── حدود الطلبات ──
# لكل IP في الدقيقة؛ ارفعه لسنتر/مدرسة كل طلابها خلف IP واحد
RATE_LIMIT_PER_MIN=300

# ── Bunny.net (فيديو + ملفات) — فارغة = الفيديو من يوتيوب فقط ──
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_TOKEN_KEY=
BUNNY_TOKEN_TTL_SEC=21600
YOUTUBE_SESSION_TTL_SEC=7200
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PULL_HOST=

# ── Paymob — فارغة = الدفع الأونلاين متوقف (الشحن بالكود يعمل) ──
# في لوحة Paymob:  Transaction processed callback = https://<DOMAIN>/api/payments/paymob/webhook
#                  Transaction response callback  = https://<DOMAIN>/payment/callback
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ── الرسائل (كود التحقق، نتيجة ولي الأمر، التذكيرات) — فارغة في الإنتاج = الرسائل تُعلَّم FAILED ──
# واتساب (Meta Cloud API): رسائل المبادرة خارج نافذة 24 ساعة تحتاج قوالب معتمدة من Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# SMS: بوابة HTTP عامة — POST JSON {to, from, text} مع Authorization: Bearer <SMS_API_KEY>
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER=MissAnn
MESSAGES_PER_SEC=20

# ── العمّال ──
# عمّال BullMQ داخل عملية الـ API (سيرفر واحد)
JOBS_ENABLED=true
