# قاعدة البيانات
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/missann?schema=public"
REDIS_URL="redis://localhost:6379"

# الخادم
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# JWT (استبدلها بقيم عشوائية طويلة في الإنتاج)
JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Bunny.net Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_TOKEN_KEY=
BUNNY_TOKEN_TTL_SEC=21600
# YouTube (فيديوهات غير مدرجة)
YOUTUBE_SESSION_TTL_SEC=7200
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PULL_HOST=

# Paymob — بدونها يرجع الدفع الأونلاين 503 (الشحن بالكود يعمل).
# في لوحة Paymob اضبط للـ integration:
#   Transaction processed callback = <API_URL>/api/payments/paymob/webhook
#   Transaction response callback  = <APP_URL>/payment/callback
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# رفع الصور محلياً (مسار نسبي لمجلد تشغيل الـ API) + تشغيل عمّال BullMQ داخل الـ API
UPLOAD_DIR=uploads
# ملفات خاصة (حلول الواجبات) — لا تجعله داخل UPLOAD_DIR العام
PRIVATE_UPLOAD_DIR=private-uploads
JOBS_ENABLED=true

# الرسائل الصادرة (كود التحقق، نتيجة ولي الأمر، تذكير اللايف، الإرسال الجماعي)
# الترتيب: واتساب أولاً ثم SMS كبديل. لو الاثنان فارغان: التطوير يسجّل الرسالة في اللوج فقط
# (الرقم مُقنَّع وكود التحقق محجوب)، والإنتاج يعلّم الرسائل FAILED.
# WhatsApp Cloud API (Meta): توكن النظام + Phone number ID. رسائل المبادرة خارج نافذة 24 ساعة
# تتطلب قوالب معتمدة من Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# SMS: بوابة HTTP عامة — POST JSON {to, from, text} مع Authorization: Bearer <SMS_API_KEY>،
# والرد {id} أو {messageId}. الرقم بصيغة 2010xxxxxxxx.
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER=MissAnn
# سقف الرسائل الصادرة في الثانية (حسب حد المزوّد)
MESSAGES_PER_SEC=20
